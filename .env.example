# Required for live checks — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live web verification — https://online.nimbleway.com (Account settings → API keys)
# Without it, Plainly falls back to Gemini's Google Search grounding.
NIMBLE_API_KEY=

# Weekly trends — Tiger Data service connection string (postgres://...?sslmode=require)
# Without it, trends live in memory.
DATABASE_URL=

# Tracing — Sentry project DSN (Python / FastAPI)
SENTRY_DSN=

# Optional
# GEMINI_MODEL=gemini-3.7-flash   # pin a model; otherwise the newest working Flash is picked
# FORCE_DEMO=1                    # use the saved sample results even with keys (wifi insurance)
# SEED_DEMO=0                     # don't add sample checks to the trends panel
# PLAINLY_CITY=New York
# PORT=8000
